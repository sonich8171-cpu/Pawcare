# Firebase Web SDK Configuration (Required for Vercel / External Hosting)
# When deploying to Vercel, paste raw values WITHOUT surrounding quotes in Project Settings -> Environment Variables.
# Obtain values from Firebase Console -> Project Settings -> General -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_DATABASE_ID=ai-studio-92294db0-8168-4098-b1ce-7401429b3ac7

# Optional Payment Gateway Readiness (Server-side only for production verification)
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
