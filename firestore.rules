        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
            incoming().notificationId == existing().notificationId &&
            incoming().userId == existing().userId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(notificationId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isSignedIn() && (existing().customerId == request.auth.uid || existing().caregiverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.caregiverId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(paymentId) &&
        isValidPayment(incoming()) &&
        incoming().paymentId == paymentId &&
        incoming().customerId == request.auth.uid &&
        incoming().status in ['pending', 'test_verified'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(paymentId) &&
        isValidPayment(incoming()) &&
        incoming().paymentId == existing().paymentId &&
        incoming().bookingId == existing().bookingId &&
        incoming().customerId == existing().customerId &&
        incoming().caregiverId == existing().caregiverId &&
        incoming().grossAmount == existing().grossAmount &&
        incoming().platformCommission == existing().platformCommission &&
        incoming().caregiverPayout == existing().caregiverPayout &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (existing().customerId == request.auth.uid &&
            incoming().status in ['test_verified', 'refund_pending'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'referenceCode', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(paymentId);
    }

    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId) && isSignedIn() && (existing().customerId == request.auth.uid || existing().caregiverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.caregiverId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(transactionId) &&
        isValidTransaction(incoming()) &&
        incoming().transactionId == transactionId &&
        incoming().customerId == request.auth.uid &&
        incoming().status in ['pending', 'test_verified'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(transactionId) &&
        isValidTransaction(incoming()) &&
        incoming().transactionId == existing().transactionId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(transactionId);
    }

    match /platformSettings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'public_config' || isAdmin());
      allow list: if resource.data.settingId == 'public_config' || isAdmin();
      allow create: if isAdmin() && isValidId(settingId) && isValidPlatformSetting(incoming()) && incoming().settingId == settingId && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(settingId) && isValidPlatformSetting(incoming()) && incoming().settingId == existing().settingId && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(settingId);
    }

    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(ticketId) &&
        isValidSupportTicket(incoming()) &&
        incoming().ticketId == ticketId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(ticketId) &&
        isValidSupportTicket(incoming()) &&
        incoming().ticketId == existing().ticketId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminResponse', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(ticketId);
    }

    match /promotions/{promoId} {
      allow get: if isValidId(promoId) && (existing().isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isAdmin();
      allow create: if isAdmin() && isValidId(promoId) && isValidPromotion(incoming()) && incoming().promoId == promoId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(promoId) && isValidPromotion(incoming()) && incoming().promoId == existing().promoId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(promoId);
    }
  }
}
